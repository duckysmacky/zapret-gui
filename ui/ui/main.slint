import { Button, ProgressIndicator, TextEdit, Palette, VerticalBox } from "std-widgets.slint";
import { AppState, Commands, Dialog, StrategyRow, CheckRow } from "globals.slint";
import { HomePage } from "pages/home.slint";
import { StrategiesPage } from "pages/strategies.slint";
import { ListsPage } from "pages/lists.slint";
import { DiagnosticsPage } from "pages/diagnostics.slint";
import { SettingsPage } from "pages/settings.slint";
import { Wizard } from "pages/wizard.slint";

export { AppState, Commands, Dialog, StrategyRow, CheckRow }

// Plainest functional layout: the owner designs the visuals later.
export component MainWindow inherits Window {
    title: "zapret-gui";
    preferred-width: 960px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 480px;
    background: Palette.background;

    property <int> page;
    property <[string]> pages: ["Главная", "Стратегии", "Списки", "Диагностика", "Настройки"];

    function apply-theme() {
        Palette.color-scheme = AppState.theme == 1 ? ColorScheme.light : AppState.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    init => {
        root.apply-theme();
    }
    changed theme => {
        root.apply-theme();
    }
    property <int> theme: AppState.theme;

    HorizontalLayout {
        if !AppState.first-run: VerticalLayout {
            width: 180px;
            padding: 8px;
            spacing: 4px;
            for name[index] in root.pages: Button {
                text: name;
                primary: root.page == index;
                clicked => {
                    root.page = index;
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }

            Text {
                text: AppState.run-state == 2 ? "● Обход включён" : AppState.run-state == 3 ? "● Ошибка" : "○ Обход выключен";
                color: AppState.run-state == 2 ? #0f7b0f : AppState.run-state == 3 ? #c42b1c : Palette.foreground;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding: 8px;
            spacing: 6px;

            if !AppState.elevated: Rectangle {
                background: #fff4ce;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Text {
                        text: "Программа запущена без прав администратора. Включение обхода, подбор и исправления недоступны.";
                        color: #3b3b3b;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Перезапустить от имени администратора";
                        clicked => {
                            Commands.restart-as-admin();
                        }
                    }
                }
            }

            if AppState.message != "": Rectangle {
                background: Palette.alternate-background;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Text {
                        text: AppState.message;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "✕";
                        clicked => {
                            AppState.message = "";
                        }
                    }
                }
            }

            if AppState.job-active && !AppState.first-run: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: AppState.job-text;
                        wrap: word-wrap;
                    }

                    ProgressIndicator {
                        progress: AppState.job-progress < 0 ? 0 : AppState.job-progress;
                        indeterminate: AppState.job-progress < 0;
                    }
                }

                if AppState.job-cancellable: Button {
                    text: "Отмена";
                    clicked => {
                        Commands.cancel-job();
                    }
                }
            }

            if AppState.first-run: Wizard {
                vertical-stretch: 1;
            }
            if !AppState.first-run && root.page == 0: HomePage {
                vertical-stretch: 1;
            }
            if !AppState.first-run && root.page == 1: StrategiesPage {
                vertical-stretch: 1;
            }
            if !AppState.first-run && root.page == 2: ListsPage {
                vertical-stretch: 1;
            }
            if !AppState.first-run && root.page == 3: DiagnosticsPage {
                vertical-stretch: 1;
            }
            if !AppState.first-run && root.page == 4: SettingsPage {
                vertical-stretch: 1;
            }
        }
    }

    // Confirmation dialog.
    if Dialog.open: Rectangle {
        background: #00000080;
        TouchArea { }

        Rectangle {
            width: min(520px, root.width - 32px);
            height: dialog-layout.preferred-height;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            dialog-layout := VerticalBox {
                Text {
                    text: Dialog.title;
                    font-size: 16px;
                    font-weight: 600;
                }

                Text {
                    text: Dialog.text;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Отмена";
                        clicked => {
                            Dialog.open = false;
                        }
                    }

                    Button {
                        text: Dialog.ok-label;
                        primary: true;
                        clicked => {
                            Dialog.open = false;
                            Commands.confirmed(Dialog.action);
                        }
                    }
                }
            }
        }
    }

    // Diagnostics report: shown in full before copying (T9).
    if AppState.report-text != "": Rectangle {
        background: #00000080;
        TouchArea { }

        Rectangle {
            width: root.width - 64px;
            height: root.height - 64px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalBox {
                Text {
                    text: "Отчёт для поддержки";
                    font-size: 16px;
                    font-weight: 600;
                }

                Text {
                    text: "Проверьте текст перед отправкой. Содержимое ваших списков в отчёт не входит.";
                    wrap: word-wrap;
                }

                report := TextEdit {
                    text: AppState.report-text;
                    read-only: true;
                    vertical-stretch: 1;
                    wrap: no-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Скопировать";
                        primary: true;
                        clicked => {
                            report.select-all();
                            report.copy();
                            AppState.message = "Отчёт скопирован в буфер обмена.";
                        }
                    }

                    Button {
                        text: "Закрыть";
                        clicked => {
                            AppState.report-text = "";
                        }
                    }
                }
            }
        }
    }
}
