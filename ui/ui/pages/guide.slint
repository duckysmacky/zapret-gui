// Full usage guide: one collapsible card per area of the app.
import { Button, ScrollView, VerticalBox } from "std-widgets.slint";
import { Card, CardHeader, PageHeader, Theme } from "../components.slint";

// A paragraph or bullet inside a section.
component GuideText inherits Text {
    wrap: word-wrap;
}

// A bold lead-in line inside a section.
component GuideHeading inherits Text {
    font-weight: 600;
    wrap: word-wrap;
}

// A card that shows only its header until "Показать" is pressed.
component GuideSection inherits Card {
    in property <image> icon;
    in property <string> title;
    in property <string> summary;
    in-out property <bool> open;

    inner-spacing: root.open ? 12px : 0px;

    CardHeader {
        icon: root.icon;
        title: root.title;
        description: root.open ? "" : root.summary;
        VerticalLayout {
            alignment: center;
            Button {
                text: root.open ? "Скрыть" : "Показать";
                clicked => {
                    root.open = !root.open;
                }
            }
        }
    }

    // @children can't sit inside `if`, so the body is clipped to zero height while closed.
    Rectangle {
        clip: true;
        height: root.open ? body.preferred-height : 0px;
        body := VerticalLayout {
            spacing: 8px;
            @children
        }
    }
}

export component GuidePage inherits ScrollView {
    VerticalBox {
        alignment: start;
        spacing: 12px;
        PageHeader {
            icon: @image-url("../icons/book-open.svg");
            title: "Руководство";
            subtitle: "Как пользоваться программой: разделы, возможности и поведение. Нажмите «Показать», чтобы раскрыть раздел.";
        }

        GuideSection {
            icon: @image-url("../icons/zap.svg");
            title: "Быстрый старт";
            summary: "Что это за программа и как включить обход за минуту.";

            GuideText {
                text: "Программа помогает открывать Discord и YouTube, когда их блокируют. Для этого она запускает обход блокировок zapret (winws.exe) и управляет им за вас. Это неофициальная программа: она не является проектом zapret.";
            }

            GuideText {
                text: "1. При первом запуске мастер скачает zapret, подберёт рабочую стратегию и предложит запускать программу вместе с Windows. Мастер можно пропустить: zapret тогда скачивается в «Настройках».";
            }

            GuideText {
                text: "2. Для работы нужны права администратора. Если их нет, сверху появится жёлтая полоса с кнопкой «Перезапустить от имени администратора».";
            }

            GuideText {
                text: "3. На «Главной» нажмите большую круглую кнопку. Когда она загорится зелёным, обход включён.";
            }

            GuideText {
                text: "4. Если что-то не открывается, нажмите «Автоподбор»: программа сама найдёт стратегию, которая работает.";
            }
        }

        GuideSection {
            icon: @image-url("../icons/house.svg");
            title: "Главная";
            summary: "Кнопка включения, выбор стратегии, игровой режим, сторож и проверка системы.";

            GuideHeading {
                text: "Большая кнопка";
            }

            GuideText {
                text: "Серая: обход выключен. Жёлтая и пульсирует: идёт запуск. Зелёная: обход работает. Красная и пульсирует: ошибка или потеряно соединение. Если кнопка не нажимается, внизу под ней написана причина: нет прав администратора или не скачан zapret.";
            }

            GuideText {
                text: "Над кнопкой показаны состояние, активная стратегия и пинг при последней проверке. При ошибке ниже появляется карточка с описанием и последними строками журнала.";
            }

            GuideHeading {
                text: "Стратегия";
            }

            GuideText {
                text: "Стратегия - это конкретный способ подключения и обхода блокировки, а именно набор параметров обхода из zapret. В списке можно выбрать её вручную, а «Автоподбор» перебирает стратегии и оставляет первую рабочую. Во время подбора интернет несколько раз ненадолго пропадает: это нормально.";
            }

            GuideHeading {
                text: "Игровой режим";
            }

            GuideText {
                text: "Включайте, если не подключается онлайн-игра. Режимы: «TCP и UDP», «Только TCP», «Только UDP». Включённый режим виден в строке состояния внизу окна. Диапазоны портов меняются в «Настройках».";
            }

            GuideHeading {
                text: "Сторож соединения";
            }

            GuideText {
                text: "Периодически проверяет, открываются ли Discord и YouTube. Если нет, кнопка и строка состояния становятся красными, а программа сообщает о сбое. Переключатель «Подбирать новую стратегию при сбое» сам запустит подбор. Период проверки задаётся в «Настройках».";
            }

            GuideHeading {
                text: "Проверка системы";
            }

            GuideText {
                text: "Кнопка «Запустить проверки» ищет то, что мешает обходу, и показывает результат прямо на «Главной». Это те же проверки, что и на странице «Диагностика».";
            }
        }

        GuideSection {
            icon: @image-url("../icons/layers.svg");
            title: "Стратегии";
            summary: "Список стратегий, быстрый и полный подбор, проверка отдельной стратегии.";

            GuideText {
                text: "Здесь перечислены все стратегии из скачанной версии zapret. Активная отмечена значком «активна». Стратегии, которые не удалось разобрать, помечены красным и недоступны.";
            }

            GuideText {
                text: "• «Быстрый подбор» останавливается на первой рабочей стратегии и включает её.";
            }

            GuideText {
                text: "• «Полный подбор» проверяет все стратегии и составляет рейтинг. Он дольше, зато можно выбрать лучшую.";
            }

            GuideText {
                text: "• «Включить» делает стратегию активной. Если обход запущен, он перезапустится с новой.";
            }

            GuideText {
                text: "• «Проверить» тестирует одну стратегию и показывает результат под её названием.";
            }

            GuideText {
                text: "Во время подбора и проверки интернет ненадолго пропадает, а выполнение можно отменить в полосе сверху.";
            }
        }

        GuideSection {
            icon: @image-url("../icons/list.svg");
            title: "Списки";
            summary: "Свои домены, исключения, режим IPSet и просмотр списков zapret.";

            GuideText {
                text: "Записи вводятся по одной на строку, можно вставить сразу много. Нажмите «Сохранить» у нужного списка: записи проверяются, мусор отклоняется, а если обход запущен, он перезапускается и применяет изменения.";
            }

            GuideText {
                text: "• «Свои домены для обхода»: сайты, которые zapret не знает, например example.com.";
            }

            GuideText {
                text: "• «Исключённые домены»: эти сайты будут открываться без обхода.";
            }

            GuideText {
                text: "• «Исключённые IP и подсети»: то же для адресов, например 1.2.3.4 или 192.168.0.0/16.";
            }

            GuideHeading {
                text: "Режим IPSet";
            }

            GuideText {
                text: "none: выключен. loaded: по списку (по умолчанию). any: все IP-адреса. В режиме any многие сайты могут перестать открываться, включайте его только осознанно. «Обновить список IPSet» скачивает свежий список.";
            }

            GuideHeading {
                text: "Списки zapret";
            }

            GuideText {
                text: "Только для просмотра: выберите список, при желании введите поиск и нажмите «Показать».";
            }
        }

        GuideSection {
            icon: @image-url("../icons/stethoscope.svg");
            title: "Диагностика";
            summary: "Проверки системы, тесты стратегий, служебные действия и журнал.";

            GuideHeading {
                text: "Проверки системы";
            }

            GuideText {
                text: "«Запустить проверки» показывает, что в порядке (зелёное), что вызывает вопросы (жёлтое) и что мешает (красное). Если проблему можно исправить, рядом появится кнопка исправления.";
            }

            GuideHeading {
                text: "Тесты стратегий";
            }

            GuideText {
                text: "«Стандартный тест» проверяет сайты Discord, YouTube и другие. «DPI-тест» ищет «заморозку» соединения после 16–20 КБ. Можно тестировать активную стратегию или все. Во время теста интернет ненадолго пропадает.";
            }

            GuideHeading {
                text: "Действия";
            }

            GuideText {
                text: "• «Удалить службы zapret / WinDivert» останавливает и удаляет старые службы и все процессы winws.exe.";
            }

            GuideText {
                text: "• «Очистить кэш Discord» закрывает Discord и удаляет его кэш.";
            }

            GuideText {
                text: "• «Обновить файл hosts» и «Восстановить hosts из копии»: файл hosts меняется только после вашего подтверждения и всегда с резервной копией.";
            }

            GuideText {
                text: "Каждое действие перед выполнением просит подтверждение.";
            }

            GuideHeading {
                text: "Журнал";
            }

            GuideText {
                text: "Сообщения программы и winws. Кнопка «Отчёт для поддержки…» собирает текст для отправки разработчику: сначала он показывается целиком, чтобы вы проверили его перед копированием. Содержимое ваших списков в отчёт не входит.";
            }
        }

        GuideSection {
            icon: @image-url("../icons/settings.svg");
            title: "Настройки";
            summary: "Тема, автозапуск, сторож, версии zapret, порты, фейковые пакеты.";

            GuideText {
                text: "• «Тема»: как в системе, светлая или тёмная.";
            }

            GuideText {
                text: "• «Запускать вместе с Windows»: программа стартует при входе в систему и работает в фоне. Нужны права администратора.";
            }

            GuideText {
                text: "• «Включать обход при запуске программы»: после старта обход включается сам.";
            }

            GuideText {
                text: "• «Сторож соединения»: включение, период проверки в минутах и автоподбор при сбое.";
            }

            GuideHeading {
                text: "Версия zapret";
            }

            GuideText {
                text: "«Проверить обновления» скачивает новейший выпуск. В выпадающем списке можно выбрать любую версию и нажать «Выбрать»: так можно вернуться к старой. Выбранная старая версия закрепляется, и обновления сами её не заменят. Неиспользуемые версии удаляются кнопкой «Удалить».";
            }

            GuideHeading {
                text: "Порты игрового режима";
            }

            GuideText {
                text: "Диапазоны для TCP и UDP, например 1024-65535 или 1024-1934,1936-65535. Не забудьте нажать «Применить».";
            }

            GuideHeading {
                text: "Фейковые пакеты";
            }

            GuideText {
                text: "Выбор файла-приманки для Discord UDP и для игр. Меняйте, только если знаете, зачем: по умолчанию всё настроено.";
            }

            GuideHeading {
                text: "О программе";
            }

            GuideText {
                text: "Версия, лицензии и авторы используемых компонентов. Кнопка «Выйти из программы» полностью останавливает обход и закрывает программу.";
            }
        }

        GuideSection {
            icon: @image-url("../icons/panel-left.svg");
            title: "Значок в трее и строка состояния";
            summary: "Что происходит при закрытии окна и как быстро управлять обходом.";

            GuideText {
                text: "Крестик в углу окна не выключает программу: окно прячется в трей (значок у часов), а обход продолжает работать. Цвет значка показывает состояние.";
            }

            GuideText {
                text: "Меню значка (правая кнопка мыши): состояние, включить или выключить обход, игровой режим, смена стратегии, автоподбор, «Открыть» и «Выход».";
            }

            GuideText {
                text: "«Выход» из меню значка (или «Выйти из программы» в «Настройках») останавливает обход полностью: winws.exe завершается.";
            }

            GuideHeading {
                text: "Строка состояния внизу окна";
            }

            GuideText {
                text: "Слева: состояние обхода, активная стратегия, игровой режим, статус сторожа и текущая задача. Справа: доступное обновление zapret, используемая версия (с пометкой «закреплена») и версия программы.";
            }
        }

        GuideSection {
            icon: @image-url("../icons/triangle-alert.svg");
            title: "Если что-то не работает";
            summary: "Порядок действий, если сайты не открываются или появилась ошибка.";

            GuideText {
                text: "1. Убедитесь, что программа запущена от имени администратора и обход включён (кнопка зелёная).";
            }

            GuideText {
                text: "2. Нажмите «Автоподбор» на «Главной» и дождитесь результата.";
            }

            GuideText {
                text: "3. Не подключается игра: включите «Игровой режим».";
            }

            GuideText {
                text: "4. Запустите «Проверка системы» и исправьте найденное: часто мешают старые службы zapret или другие программы с WinDivert.";
            }

            GuideText {
                text: "5. Выполните «DPI-тест» на странице «Диагностика» и «Полный подбор» на странице «Стратегии».";
            }

            GuideText {
                text: "6. Проверьте обновления zapret в «Настройках»: если провайдер изменил блокировку, помогает свежая версия.";
            }

            GuideText {
                text: "7. Если ничего не помогло, откройте «Диагностика», нажмите «Отчёт для поддержки…» и отправьте текст разработчику.";
            }
        }
    }
}
