import { Button, ComboBox, LineEdit, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";
import { AppState, Commands } from "../globals.slint";
import { Card, CardHeader, PageHeader, Theme } from "../components.slint";

component UserList inherits Card {
    in property <image> icon;
    in property <string> title;
    in property <int> kind;
    in property <string> hint;
    in-out property <string> entries;

    CardHeader {
        icon: root.icon;
        title: root.title;
        description: root.hint;
        VerticalLayout {
            alignment: center;
            Button {
                text: "Сохранить";
                icon: @image-url("../icons/check.svg");
                colorize-icon: true;
                clicked => {
                    Commands.save-list(root.kind, root.entries);
                }
            }
        }
    }

    TextEdit {
        text <=> root.entries;
        min-height: 90px;
        wrap: no-wrap;
    }
}

export component ListsPage inherits ScrollView {
    property <int> upstream-index;
    property <string> filter;

    VerticalBox {
        alignment: start;
        spacing: 12px;
        PageHeader {
            icon: @image-url("../icons/list.svg");
            title: "Списки";
            subtitle: "По одной записи на строку. Можно вставить сразу много строк. Изменения применяются сразу (обход перезапустится).";
        }

        UserList {
            icon: @image-url("../icons/zap.svg");
            title: "Свои домены для обхода";
            hint: "Например: example.com";
            entries <=> AppState.list-general;
        }

        UserList {
            icon: @image-url("../icons/x.svg");
            title: "Исключённые домены";
            hint: "Эти сайты будут открываться без обхода.";
            kind: 1;
            entries <=> AppState.list-exclude;
        }

        UserList {
            icon: @image-url("../icons/shield-off.svg");
            title: "Исключённые IP и подсети";
            hint: "Например: 192.168.0.0/16 или 1.2.3.4";
            kind: 2;
            entries <=> AppState.list-ipset-exclude;
        }

        Card {
            CardHeader {
                icon: @image-url("../icons/settings.svg");
                title: "Режим IPSet";
                description: AppState.ipset-list-updated ? "Используется обновлённый список" : "Используется список из версии zapret";
            }

            ComboBox {
                model: ["none: выключен", "loaded: по списку (по умолчанию)", "any: все IP-адреса"];
                current-index <=> AppState.ipset-mode;
                selected => {
                    Commands.set-ipset-mode(self.current-index);
                }
            }

            if AppState.ipset-mode == 2: Text {
                text: "Внимание: в режиме any многие сайты могут перестать открываться.";
                color: Theme.error;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Обновить список IPSet";
                    icon: @image-url("../icons/refresh-cw.svg");
                    colorize-icon: true;
                    enabled: AppState.elevated;
                    clicked => {
                        Commands.update-ipset-list();
                    }
                }
            }
        }

        Card {
            CardHeader {
                icon: @image-url("../icons/layers.svg");
                title: "Списки zapret";
                description: "Только просмотр.";
            }

            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        model: AppState.upstream-lists;
                        current-index <=> root.upstream-index;
                        horizontal-stretch: 1;
                    }

                    LineEdit {
                        placeholder-text: "Поиск";
                        text <=> root.filter;
                        horizontal-stretch: 1;
                        accepted => {
                            Commands.load-upstream-list(AppState.upstream-lists[root.upstream-index], root.filter);
                        }
                    }

                    Button {
                        text: "Показать";
                        enabled: AppState.upstream-lists.length > 0;
                        clicked => {
                            Commands.load-upstream-list(AppState.upstream-lists[root.upstream-index], root.filter);
                        }
                    }
                }

                TextEdit {
                    text <=> AppState.upstream-list-text;
                    read-only: true;
                    min-height: 200px;
                    wrap: no-wrap;
                }
            }
        }
    }
}
